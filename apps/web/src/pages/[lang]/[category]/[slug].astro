---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import PageHero from '../../../components/PageHero.astro';
import PerformanceGallery from '../../../components/PerformanceGallery.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';
import AudioEmbed from '../../../components/AudioEmbed.astro';
import ShowingsList from '../../../components/ShowingsList.astro';
import { getCategoryUrl } from '../../../utils/routes';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => {
    // Only generate routes for detail pages with published status
    return data.status === 'published' && data.type === 'detail';
  });

  return pages.map(page => {
    // Extract slug from page.id (file path)
    // Handle both flat structure (en/file.md) and nested structure (en/folder/file.md)
    let slug = page.id.replace(/^(en|et)\//, '').replace(/\.md$/, '');

    // If file is in nested folder, extract just the filename
    // e.g., "performances/for-adults/shame" -> "shame"
    if (slug.includes('/')) {
      slug = slug.split('/').pop() || slug;
    }

    // Use frontmatter slug if available (it's the canonical source)
    const frontmatterSlug = page.data.slug;
    if (frontmatterSlug) {
      // Extract filename from frontmatter slug if it contains path separators
      slug = frontmatterSlug.includes('/')
        ? frontmatterSlug.split('/').pop()
        : frontmatterSlug;
    }

    // Translate category for URL based on language
    const categoryUrl = getCategoryUrl(page.data.category, page.data.language);

    return {
      params: {
        lang: page.data.language,
        category: categoryUrl,
        slug: slug,
      },
      props: { page },
    };
  });
}

const { page } = Astro.props;
const { Content } = await page.render();
// Extract slug for LanguageSwitcher - use filename from path or frontmatter
let currentSlug = page.id.replace(/^(en|et)\//, '').replace(/\.md$/, '');
if (currentSlug.includes('/')) {
  currentSlug = currentSlug.split('/').pop() || currentSlug;
}
if (page.data.slug) {
  currentSlug = page.data.slug.split('/').pop() || page.data.slug;
}

// Compute alternate language URL for hreflang
const altLang = page.data.language === 'et' ? 'en' : 'et';
const translation = page.data.translated?.find((t: { language: string }) => t.language === altLang);
const altCategoryUrl = getCategoryUrl(page.data.category, altLang);
const alternateUrl = translation ? `/${altLang}/${altCategoryUrl}/${translation.slug}` : undefined;

// Section titles based on language
const sectionTitles = {
  audio: page.data.language === 'et' ? 'Helid' : 'Audio',
  gallery: page.data.language === 'et' ? 'Pildid' : 'Gallery',
  video: page.data.language === 'et' ? 'Videod' : 'Videos',
};
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  language={page.data.language}
  ogImage={page.data.hero_image}
  alternateUrl={alternateUrl}
>
  <LanguageSwitcher
    slot="language-switcher"
    currentLang={page.data.language}
    currentSlug={currentSlug}
    translations={page.data.translated}
    category={page.data.category}
  />

  <PageHero
    title={page.data.title}
    subtitle={page.data.description}
    imageUrl={page.data.hero_image}
    videoUrl={page.data.hero_video}
  />

  <article class="prose prose-lg prose-slate max-w-4xl mx-auto mb-16">
    <Content />
  </article>

  {page.data.showings && page.data.showings.length > 0 && (
    <ShowingsList
      showings={page.data.showings}
      language={page.data.language}
      premiereDate={page.data.premiere?.date}
      defaultVenueId={page.data.premiere?.venue_id}
    />
  )}

  {page.data.audio && page.data.audio.length > 0 && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <h2 class="text-3xl font-bold text-slate-900 mb-8">{sectionTitles.audio}</h2>
      <AudioEmbed audio={page.data.audio} />
    </div>
  )}

  {page.data.gallery && page.data.gallery.length > 0 && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <h2 class="text-3xl font-bold text-slate-900 mb-8">{sectionTitles.gallery}</h2>
      <PerformanceGallery images={page.data.gallery} />
    </div>
  )}

  {page.data.videos && page.data.videos.length > 0 && (
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <h2 class="text-3xl font-bold text-slate-900 mb-8">{sectionTitles.video}</h2>
      <VideoEmbed videos={page.data.videos} />
    </div>
  )}
</BaseLayout>
