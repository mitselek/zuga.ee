---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import PageHero from '../../../components/PageHero.astro';
import PerformanceGallery from '../../../components/PerformanceGallery.astro';
import VideoEmbed from '../../../components/VideoEmbed.astro';

export async function getStaticPaths() {
  // Category translation mapping for URLs
  const categoryUrlMap = {
    etendused: {
      en: 'performances',
      et: 'etendused',
    },
    workshopid: {
      en: 'workshops',
      et: 'workshopid',
    },
  };

  // Subcategory translation mapping for URLs
  const subcategoryUrlMap = {
    'noorele-publikule': {
      en: 'for-young-audiences',
      et: 'noorele-publikule',
    },
    'suurtele': {
      en: 'for-adults',
      et: 'suurtele',
    },
  };

  const pages = await getCollection('pages', ({ data }) => {
    // Only generate routes for section pages with subcategories
    return data.status === 'published' && data.type === 'section' && data.subcategory;
  });

  return pages.map(page => {
    // Translate category for URL based on language
    const categoryUrl = categoryUrlMap[page.data.category]?.[page.data.language] || page.data.category;

    // Translate subcategory for URL based on language
    const subcategoryUrl = subcategoryUrlMap[page.data.subcategory]?.[page.data.language] || page.data.subcategory;

    return {
      params: {
        lang: page.data.language,
        category: categoryUrl,
        subcategory: subcategoryUrl,
      },
      props: { page },
    };
  });
}

const { page } = Astro.props;
const { Content } = await page.render();

// Get all detail pages in this subcategory
const allPages = await getCollection('pages');
const detailPages = allPages.filter(p =>
  p.data.language === page.data.language &&
  p.data.category === page.data.category &&
  p.data.subcategory === page.data.subcategory &&
  p.data.type === 'detail' &&
  p.data.status === 'published'
);

// Extract slug for LanguageSwitcher
const currentSlug = page.data.slug || page.id.replace(/^(en|et)\//, '').replace(/\.md$/, '');
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  language={page.data.language}
>
  <LanguageSwitcher
    slot="language-switcher"
    currentLang={page.data.language}
    currentSlug={currentSlug}
    translations={page.data.translated}
  />

  <PageHero
    title={page.data.title}
    subtitle={page.data.description}
    type={page.data.type}
    imageUrl={page.data.hero_image}
    videoUrl={page.data.hero_video}
  />

  <article class="prose prose-lg prose-slate max-w-4xl mx-auto mb-16 px-4">
    <Content />
  </article>

  {page.data.gallery && page.data.gallery.length > 0 && (
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center" style="font-family: var(--font-heading); color: var(--color-primary);">
        {page.data.language === 'et' ? 'Galerii' : 'Gallery'}
      </h2>
      <PerformanceGallery images={page.data.gallery} />
    </section>
  )}

  {page.data.videos && page.data.videos.length > 0 && (
    <section class="mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center" style="font-family: var(--font-heading); color: var(--color-primary);">
        {page.data.language === 'et' ? 'Videod' : 'Videos'}
      </h2>
      <VideoEmbed videos={page.data.videos} />
    </section>
  )}

  <!-- Show list of performances in this subcategory -->
  {detailPages.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 mb-16">
      <h2 class="text-3xl font-bold mb-8 text-center" style="font-family: var(--font-heading); color: var(--color-primary);">
        {page.data.language === 'et' ? 'Etendused' : 'Performances'}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {detailPages.map(performance => {
          const performanceSlug = performance.id.replace(/^(en|et)\//, '').replace(/\.md$/, '');
          // Extract just the filename for the URL
          const slugParts = performanceSlug.split('/');
          const slug = slugParts[slugParts.length - 1];

          // Build category URL
          const categoryUrlMap = {
            etendused: {
              en: 'performances',
              et: 'etendused',
            },
            workshopid: {
              en: 'workshops',
              et: 'workshopid',
            },
          };
          const categoryUrl = categoryUrlMap[performance.data.category]?.[performance.data.language] || performance.data.category;
          const href = `/${performance.data.language}/${categoryUrl}/${slug}`;

          return (
            <a
              href={href}
              class="group block p-6 bg-white rounded-lg shadow-md hover:shadow-xl transition-shadow duration-300 border border-gray-200 hover:border-accent"
            >
              {performance.data.hero_image && (
                <img
                  src={performance.data.hero_image}
                  alt={performance.data.title}
                  class="w-full h-48 object-cover rounded-md mb-4"
                />
              )}
              <h3 class="text-xl font-bold mb-2 group-hover:text-accent transition-colors" style="font-family: var(--font-heading); color: var(--color-primary);">
                {performance.data.title}
              </h3>
              {performance.data.description && (
                <p class="text-gray-600 text-sm line-clamp-3">
                  {performance.data.description}
                </p>
              )}
            </a>
          );
        })}
      </div>
    </section>
  )}
</BaseLayout>
