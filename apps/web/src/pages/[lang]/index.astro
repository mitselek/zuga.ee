---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../components/LanguageSwitcher.astro';
import HomeSection from '../../components/HomeSection.astro';
import ContentCard from '../../components/ContentCard.astro';
import EventCard from '../../components/EventCard.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => {
    // Only generate routes for home pages with published status
    return data.status === 'published' && data.type === 'home';
  });

  return pages.map(page => ({
    params: {
      lang: page.data.language,
    },
    props: { page },
  }));
}

const { page } = Astro.props;
const { Content } = await page.render();

// Category translation mapping for URLs
const categoryTranslations: Record<string, Record<string, string>> = {
  etendused: {
    en: 'performances',
    et: 'etendused',
  },
  workshopid: {
    en: 'workshops',
    et: 'workshopid',
  },
  about: {
    en: 'about',
    et: 'about',
  },
  gallery: {
    en: 'gallery',
    et: 'gallery',
  },
  contact: {
    en: 'contact',
    et: 'contact',
  },
  news: {
    en: 'news',
    et: 'news',
  },
  kalender: {
    en: 'calendar',
    et: 'kalender',
  },
};

// Get all published pages in current language
const allPages = await getCollection('pages', ({ data }) => {
  return data.status === 'published' && data.language === page.data.language;
});

// Get all section pages and sort by order field
// Exclude subsections (they render within their parent section)
const excludeCategories = ['gallery','contact','about','news'];
const sections = allPages
  .filter(p => {
    return p.data.type === 'section' &&
           p.data.page_type === 'landing' &&
           !p.data.subcategory &&
           !excludeCategories.includes(p.data.category);
  })
  .sort((a, b) => {
    const orderA = a.data.order ?? 999;
    const orderB = b.data.order ?? 999;
    if (orderA !== orderB) return orderA - orderB;
    return a.data.category.localeCompare(b.data.category);
  });

// Helper function to get detail items for a category
const getDetailItems = (category: string) =>
  allPages.filter(p => p.data.category === category && p.data.type === 'detail');

// Helper function to get subsections for a category
const getSubsections = (category: string) =>
  allPages
    .filter(p => p.data.category === category && p.data.page_type === 'landing' && p.data.subcategory)
    .sort((a, b) => {
      const orderA = a.data.order ?? 999;
      const orderB = b.data.order ?? 999;
      if (orderA !== orderB) return orderA - orderB;
      return (a.data.subcategory || '').localeCompare(b.data.subcategory || '');
    });

// Get 5 upcoming events for homepage
const allEvents = await getCollection('pages', ({ data }) => {
  return (
    data.status === 'published' &&
    data.language === page.data.language &&
    (data.category === 'etendused' || data.category === 'workshopid') &&
    (data.premiere?.date || data.showings?.length > 0)
  );
});

const todayStr = new Date().toISOString().split('T')[0];
const upcomingEventDates = allEvents
  .flatMap(event => {
    const dates = [];
    // Add premiere if exists and in future
    if (event.data.premiere?.date) {
      dates.push({
        date: event.data.premiere.date,
        time: event.data.premiere.time,
        venue_id: event.data.premiere.venue_id,
        page: event,
        type: 'premiere' as const,
      });
    }
    // Add showings if exist and in future
    if (event.data.showings) {
      for (const showing of event.data.showings) {
        dates.push({
          date: showing.date,
          time: showing.time,
          venue_id: showing.venue_id || event.data.premiere?.venue_id,
          page: event,
          type: 'showing' as const,
        });
      }
    }
    return dates;
  })
  .filter(e => e.date >= todayStr)
  .sort((a, b) => a.date.localeCompare(b.date))
  .slice(0, 5);

// Get 5 most recent past events for homepage
const pastEventDates = allEvents
  .flatMap(event => {
    const dates = [];
    // Add premiere if exists
    if (event.data.premiere?.date) {
      dates.push({
        date: event.data.premiere.date,
        time: event.data.premiere.time,
        venue_id: event.data.premiere.venue_id,
        page: event,
        type: 'premiere' as const,
      });
    }
    // Add showings if exist
    if (event.data.showings) {
      for (const showing of event.data.showings) {
        dates.push({
          date: showing.date,
          time: showing.time,
          venue_id: showing.venue_id || event.data.premiere?.venue_id,
          page: event,
          type: 'showing' as const,
        });
      }
    }
    return dates;
  })
  .filter(e => e.date < todayStr)
  .sort((a, b) => b.date.localeCompare(a.date)) // Descending - most recent first
  .slice(0, 5);

const isEstonian = page.data.language === 'et';

// Homepage promo banner: "Mis sul viga on?"
// Look up by file id to be robust even if slug field changes.
const misSulVigaOnPage =
  isEstonian
    ? allPages.find((p) =>
        p.data.type === 'detail' &&
        p.data.category === 'etendused' &&
        p.id.endsWith('/etendused/noorele-publikule/mis-sul-viga-on.md'),
      )
    : undefined;
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  language={page.data.language}
  isHomepage={true}
>
  <!-- Floating language switcher -->
  <div class="fixed top-8 right-8 z-50">
    <LanguageSwitcher
      currentLang={page.data.language}
      currentSlug="index"
      translations={page.data.translated}
    />
  </div>

  <!-- Hero Section -->
  <section
    id="hero"
    class="min-h-screen flex items-center justify-center relative bg-slate-900"
    style={page.data.hero_image ? `background-image: url('${page.data.hero_image}'); background-size: cover; background-position: center;` : ''}
  >
    {page.data.hero_image && (
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/60 to-slate-900/40"></div>
    )}
    <div class="relative z-10 w-full max-w-full lg:max-w-[50vw] mx-auto px-4 py-16 text-center">
      <h1 class={`text-5xl md:text-7xl font-bold mb-6 ${page.data.hero_image ? 'text-white' : 'text-slate-900'}`}>
        {page.data.title}
      </h1>
      <p class={`text-xl md:text-2xl mb-8 ${page.data.hero_image ? 'text-white/90' : 'text-slate-600'}`}>
        {page.data.description}
      </p>

      {misSulVigaOnPage && (
        <a
          href={`/${page.data.language}/${categoryTranslations.etendused?.[page.data.language] ?? 'etendused'}/${misSulVigaOnPage.data.slug ?? 'mis-sul-viga-on'}`}
          class="mt-10 block w-full lg:max-w-[40vw] mx-auto rounded-2xl overflow-hidden border border-white/20 bg-white/10 backdrop-blur hover:bg-white/15 transition"
          aria-label='Ava "Mis sul viga on?" leht'
        >
          <div
            class="relative min-h-[180px] flex items-end"
            style={`background-image: url('${misSulVigaOnPage.data.hero_image}'); background-size: cover; background-position: center;`}
          >
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/35 to-slate-900/10"></div>
            <div class="relative z-10 w-full p-6 text-left">
              <div class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3 py-1 text-xs font-semibold text-white/90 border border-white/20">
                Tulemas
              </div>
              <h2 class="mt-3 text-2xl md:text-3xl font-bold text-white">
                Mis sul viga on?
              </h2>
              <p class="mt-2 text-white/90">
                {misSulVigaOnPage.data.description}
              </p>
              <div class="mt-4 text-sm font-semibold text-blue-200">
                Vaata lähemalt <span aria-hidden="true">→</span>
              </div>
            </div>
          </div>
        </a>
      )}
    </div>
  </section>

  <!-- Meist Section -->
  <section id="category-about" class="py-20 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4">
      <div class="prose prose-lg mx-auto prose-slate">
        <Content />
      </div>
    </div>
  </section>

  <!-- Upcoming Events Section -->
  {upcomingEventDates.length > 0 && (
    <section 
      class="py-16 relative"
      style="background-image: url('https://fienta.com/cf/img/?width=1070&dpr=1&format=webp&v=1764153816&gcs=true&file=/uploads/2025/11/157610/157610-et-251126124336.png'); background-size: cover; background-position: center;"
    >
      <div class="absolute inset-0 bg-slate-900/70"></div>
      <div class="max-w-7xl mx-auto px-4 relative z-10">
        <div class="flex justify-between items-center mb-12">
          <h2 class="text-4xl font-bold text-white">
            {isEstonian ? 'Tulemas' : 'Upcoming'}
          </h2>
          <a
            href={`/${page.data.language}/${isEstonian ? 'kalender' : 'calendar'}/${isEstonian ? 'tulemas' : 'upcoming'}`}
            class="text-blue-300 hover:text-blue-100 font-medium flex items-center gap-2"
          >
            {isEstonian ? 'Vaata kõiki' : 'View all'}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {upcomingEventDates.map(event => (
            <EventCard event={event} language={page.data.language} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Past Events Section -->
  {pastEventDates.length > 0 && (
    <section class="py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex justify-between items-center mb-12">
          <h2 class="text-4xl font-bold text-slate-900">
            {isEstonian ? 'Hiljuti olnud' : 'Recent Past'}
          </h2>
          <a
            href={`/${page.data.language}/${isEstonian ? 'kalender' : 'calendar'}/${isEstonian ? 'olnud' : 'past'}`}
            class="text-blue-600 hover:text-blue-800 font-medium flex items-center gap-2"
          >
            {isEstonian ? 'Vaata kõiki' : 'View all'}
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {pastEventDates.map(event => (
            <EventCard event={event} language={page.data.language} />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Dynamic Sections -->
  {sections.map(async (section, index) => {
    const detailItems = getDetailItems(section.data.category);
    const subsections = getSubsections(section.data.category);
    const hasSubsections = subsections.length > 0;

    // Render section markdown content
    const { Content: SectionContent } = await section.render();

    // Alternate background colors
    const background = index % 2 === 0 ? 'white' : 'slate';

    return (
      <HomeSection
        id={`category-${section.data.category}`}
        title={section.data.title}
        description={section.data.description}
        heroImage={section.data.hero_image}
        backgroundColor={section.data.background_color}
        background={background}
        isFirstSection={index === 0}
      >
        {/* Render section markdown content with light overlay for hero images */}
        {section.data.hero_image ? (
          <div class="relative -mx-4 px-4 py-6 mb-12">
            <div class="absolute inset-0 bg-white/40"></div>
            <div class="prose prose-lg max-w-none relative z-10 [text-shadow:_0_2px_8px_rgb(255_255_255_/_80%)]">
              <SectionContent />
            </div>
          </div>
        ) : (
          <div class="prose prose-lg max-w-none mb-12">
            <SectionContent />
          </div>
        )}

        {hasSubsections ? (
          // Render subsections (e.g., Suurtele, Noorele Publikule)
          <>
            {subsections.map(subsection => {
              const subsectionItems = detailItems.filter(p => p.data.subcategory === subsection.data.subcategory);
              return (
                <div
                  id={`category-${subsection.data.subcategory}`}
                  class="mb-16 rounded-lg p-8 relative"
                  style={subsection.data.hero_image ? `background-image: url('${subsection.data.hero_image}'); background-size: cover; background-position: center;` : ''}
                >
                  {subsection.data.hero_image && (
                    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/70 to-slate-900/50 rounded-lg"></div>
                  )}
                  <div class="relative z-10">
                    <h3 class={`text-2xl font-semibold mb-6 ${subsection.data.hero_image ? 'text-white' : 'text-slate-800'}`}>
                      {subsection.data.title}
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                      {subsectionItems.map(item => {
                        let slug = item.id.replace(/^(en|et)\//, '').replace(/\.md$/, '');
                        // Extract just filename if nested in folders
                        if (slug.includes('/')) {
                          slug = slug.split('/').pop() || slug;
                        }
                        // Translate category for URL
                        const translatedCategory = categoryTranslations[item.data.category]?.[page.data.language] || item.data.category;
                        return (
                          <ContentCard
                            title={item.data.title}
                            description={item.data.description}
                            href={`/${page.data.language}/${translatedCategory}/${slug}`}
                            subcategory={subsection.data.title}
                            image={item.data.hero_image}
                          />
                        );
                      })}
                    </div>
                  </div>
                </div>
              );
            })}
          </>
        ) : (
          // Render regular detail items in grid
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {detailItems.map(item => {
              let slug = item.id.replace(/^(en|et)\//, '').replace(/\.md$/, '');
              // Extract just filename if nested in folders
              if (slug.includes('/')) {
                slug = slug.split('/').pop() || slug;
              }
              // Translate category for URL
              const translatedCategory = categoryTranslations[item.data.category]?.[page.data.language] || item.data.category;
              return (
                <ContentCard
                  title={item.data.title}
                  description={item.data.description}
                  href={`/${page.data.language}/${translatedCategory}/${slug}`}
                  image={item.data.hero_image}
                />
              );
            })}
          </div>
        )}
      </HomeSection>
    );
  })}
</BaseLayout>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
