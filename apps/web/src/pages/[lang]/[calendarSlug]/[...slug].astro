---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LanguageSwitcher from '../../../components/LanguageSwitcher.astro';
import PageHero from '../../../components/PageHero.astro';
import EventList from '../../../components/EventList.astro';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => {
    return data.status === 'published' && data.category === 'kalender';
  });

  const paths = [];

  // Create routes for main calendar pages and sub-pages
  for (const page of pages) {
    const calendarSlug = page.data.language === 'et' ? 'kalender' : 'calendar';

    // Main calendar page (kalender/calendar) - route should be /{lang}/kalender or /{lang}/calendar
    if (page.data.slug === 'kalender' || page.data.slug === 'calendar') {
      paths.push({
        params: {
          lang: page.data.language,
          calendarSlug,
          slug: undefined, // Base route
        },
        props: { page },
      });
    } else {
      // Sub-pages (tulemas/upcoming, olnud/past)
      paths.push({
        params: {
          lang: page.data.language,
          calendarSlug,
          slug: page.data.slug,
        },
        props: { page },
      });
    }
  }

  // Also create routes for upcoming/past pages even if markdown files don't exist
  // These are dynamic routes that query events
  const languages = ['et', 'en'];
  for (const lang of languages) {
    const calendarSlug = lang === 'et' ? 'kalender' : 'calendar';

    // Upcoming page
    paths.push({
      params: {
        lang,
        calendarSlug,
        slug: lang === 'et' ? 'tulemas' : 'upcoming',
      },
      props: {
        page: null, // Will be handled in component
        isDynamic: true,
        pageType: 'upcoming',
      },
    });
    // Past page
    paths.push({
      params: {
        lang,
        calendarSlug,
        slug: lang === 'et' ? 'olnud' : 'past',
      },
      props: {
        page: null,
        isDynamic: true,
        pageType: 'past',
      },
    });
  }

  return paths;
}

const { page, isDynamic, pageType } = Astro.props;
const slug = Astro.params.slug || '';

// Handle dynamic pages (upcoming/past) that don't have markdown files
let pageData = page;
let pageContent = null;

if (isDynamic && !page) {
  // Create virtual page data for dynamic routes
  if (pageType === 'upcoming') {
    pageData = {
      data: {
        title: Astro.params.lang === 'et' ? 'Tulemas' : 'Upcoming',
        description: Astro.params.lang === 'et'
          ? 'Tulevased ZUGA üritused'
          : 'Upcoming ZUGA events',
        language: Astro.params.lang,
        category: 'kalender',
      },
    };
  } else if (pageType === 'past') {
    pageData = {
      data: {
        title: Astro.params.lang === 'et' ? 'Olnud' : 'Past',
        description: Astro.params.lang === 'et'
          ? 'Varasemad ZUGA üritused'
          : 'Past ZUGA events',
        language: Astro.params.lang,
        category: 'kalender',
      },
    };
  }
} else if (page) {
  const rendered = await page.render();
  pageContent = rendered.Content;
}

// Get today's date in Estonia timezone (UTC+2/UTC+3)
const today = new Date();
const estoniaOffset = today.getTimezoneOffset() + 120; // UTC+2 in minutes
const todayEstonia = new Date(today.getTime() + estoniaOffset * 60000);
const todayStr = todayEstonia.toISOString().split('T')[0]; // YYYY-MM-DD

const currentLang = pageData.data.language;
const calendarSlug = currentLang === 'et' ? 'kalender' : 'calendar';

// Get all events (performances and workshops) with premiere or showings
const allEvents = await getCollection('pages', ({ data }) => {
  return (
    data.status === 'published' &&
    data.language === currentLang &&
    (data.category === 'etendused' || data.category === 'workshopid') &&
    (data.premiere?.date || data.showings?.length > 0)
  );
});

/**
 * Extract event dates from a page
 * Returns array of { date, time, venue_id, page, type: 'premiere' | 'showing' }
 *
 * Handles edge cases:
 * - Events with only premiere (no showings) → premiere date included
 * - Events with only showings (no premiere) → showing dates included
 * - Events with premiere in past but showings in future → both included (appears in both lists)
 */
function getEventDates(eventPage: any) {
  const dates: Array<{
    date: string;
    time?: string;
    venue_id?: string;
    page: any;
    type: 'premiere' | 'showing';
  }> = [];

  // Add premiere date if exists (even if showings also exist)
  if (eventPage.data.premiere?.date) {
    dates.push({
      date: eventPage.data.premiere.date,
      time: eventPage.data.premiere.time,
      venue_id: eventPage.data.premiere.venue_id,
      page: eventPage,
      type: 'premiere',
    });
  }

  // Add showing dates if exist (even if premiere also exists)
  if (eventPage.data.showings && eventPage.data.showings.length > 0) {
    for (const showing of eventPage.data.showings) {
      dates.push({
        date: showing.date,
        time: showing.time,
        venue_id: showing.venue_id || eventPage.data.premiere?.venue_id, // Fallback to premiere venue
        page: eventPage,
        type: 'showing',
      });
    }
  }

  return dates;
}

// Flatten all events into individual date entries
const allEventDates = allEvents.flatMap(getEventDates);

// Filter events based on slug
let filteredEvents = allEventDates;
let isUpcomingPage = false;
let isPastPage = false;

if (slug === 'tulemas' || slug === 'upcoming') {
  // Upcoming events: date >= today
  // Include events with premiere in past but showings in future
  filteredEvents = allEventDates.filter(event => event.date >= todayStr);
  // Sort by date ascending (closest first)
  filteredEvents.sort((a, b) => a.date.localeCompare(b.date));
  isUpcomingPage = true;
} else if (slug === 'olnud' || slug === 'past') {
  // Past events: date < today
  // Include events with premiere in past (even if they have future showings)
  filteredEvents = allEventDates.filter(event => event.date < todayStr);
  // Sort by date descending (most recent first)
  filteredEvents.sort((a, b) => b.date.localeCompare(a.date));
  isPastPage = true;
} else {
  // Main calendar page - show all events sorted by date
  filteredEvents.sort((a, b) => a.date.localeCompare(b.date));
}

// Events are now grouped by EventList component

---

<BaseLayout
  title={pageData.data.title}
  description={pageData.data.description}
  language={pageData.data.language}
>
  <LanguageSwitcher
    slot="language-switcher"
    currentLang={pageData.data.language}
    currentSlug={slug || 'index'}
    translations={pageData.data.translated}
    calendarPrefix={calendarSlug}
  />

  <PageHero
    title={pageData.data.title}
    subtitle={pageData.data.description}
    imageUrl={pageData.data.hero_image}
    videoUrl={pageData.data.hero_video}
  />

  <main class="container mx-auto px-4 py-8">
    {pageContent && <pageContent />}

    {filteredEvents.length > 0 ? (
      <EventList events={filteredEvents} language={currentLang as 'et' | 'en'} groupByMonth={true} />
    ) : (
      <div class="mt-12 text-center text-gray-600 py-12">
        {isUpcomingPage ? (
          <div>
            <p class="text-lg mb-2">
              {currentLang === 'et'
                ? 'Tulevasi üritusi hetkel pole.'
                : 'No upcoming events at the moment.'}
            </p>
            <p class="text-sm">
              {currentLang === 'et'
                ? 'Vaata tagasi varsti uute ürituste jaoks.'
                : 'Check back soon for new events.'}
            </p>
          </div>
        ) : isPastPage ? (
          <div>
            <p class="text-lg mb-2">
              {currentLang === 'et'
                ? 'Varasemaid üritusi ei leitud.'
                : 'No past events found.'}
            </p>
            <p class="text-sm">
              {currentLang === 'et'
                ? 'ZUGA esimene etendus oli 2006. aastal.'
                : 'ZUGA\'s first performance was in 2006.'}
            </p>
          </div>
        ) : (
          <p>
            {currentLang === 'et'
              ? 'Üritusi ei leitud.'
              : 'No events found.'}
          </p>
        )}
      </div>
    )}
  </main>
</BaseLayout>
